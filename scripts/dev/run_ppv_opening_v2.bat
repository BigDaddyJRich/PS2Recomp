@echo off
setlocal
rem PPV opening v2 test (Nov 7): PPV MODE -> PLAY SAMPLE PPV -> PLAY -> opening 1999+1902 -> card.
set "ROOT=%~dp0..\..\"
set "GAME=F:\HCTP MODS\Vanilla"
set "RUNNER=%ROOT%out\native-gs\ps2xRuntime\ps2EntryRunner.exe"
cd /d "%GAME%"
set "HCTP_RENDERER=d3d11"
set "HCTP_MOVIES=native"
set "HCTP_TITLE_MOVIES=1"
set "HCTP_GS_THREAD=1"
set "VENDETTA_UNLOCKALL=1"
set "HCTP_GPU_CHARS_LITE=1"
set "HCTP_GPU_STAGE1=0"
set "HCTP_ZREAD_NODRAIN=1"
set "HCTP_S1_SBRING=0"
set "HCTP_CHAINBUF_POOL=1"
set "VENDETTA_PADS=1"
set "VENDETTA_NO_HOST_INPUT=1"
if not defined HCTP_SHOT_DIR set "HCTP_SHOT_DIR=%~dp0..\..\logs\ppvshots"
if not exist "%HCTP_SHOT_DIR%" mkdir "%HCTP_SHOT_DIR%"
if not defined PPV_SCRIPT set "PPV_SCRIPT=12:START,20:START,28:START,36:START,48:DOWN,50:DOWN,52:DOWN,55:CROSS,61:CROSS,66:DOWN,68:CROSS"
set "VENDETTA_PADSCRIPT=%PPV_SCRIPT%"
if not defined PPV_LOG set "PPV_LOG=ppvop_v2"
set "HCTP_PPV_OPENING=1"
set "HCTP_EVTLOG=1"
"%RUNNER%" SLUS_207.87 > "%~dp0..\..\logs\%PPV_LOG%.out" 2> "%~dp0..\..\logs\%PPV_LOG%.err"
